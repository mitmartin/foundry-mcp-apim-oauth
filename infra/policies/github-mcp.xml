<policies>
  <!--
    Policy for GitHub's hosted MCP server (https://api.githubcopilot.com/mcp/).
    The caller's Authorization header (the signed-in user's GitHub token) is
    forwarded unchanged. API Management never stores the token.
    main.bicep replaces __GITHUB_TOOLSETS__ and __GITHUB_READONLY__ at deployment.
  -->
  <inbound>
    <base />
    <!-- Every call must carry the signed-in user's GitHub token. -->
    <choose>
      <when condition='@(!context.Request.Headers.ContainsKey("Authorization"))'>
        <return-response>
          <set-status code="401" reason="GitHub authorization required" />
        </return-response>
      </when>
    </choose>
    <!-- GitHub's hosted MCP endpoint requires the trailing slash. -->
    <rewrite-uri template="/mcp/" copy-unmatched-params="true" />
    <set-header name="User-Agent" exists-action="override">
      <value>Foundry-MCP-Gateway</value>
    </set-header>
    <!-- Enforce the tool catalog and read-only mode for every agent centrally. -->
    <set-header name="X-MCP-Toolsets" exists-action="override">
      <value>__GITHUB_TOOLSETS__</value>
    </set-header>
    <set-header name="X-MCP-Readonly" exists-action="override">
      <value>__GITHUB_READONLY__</value>
    </set-header>
    <!-- Agent traffic arrives from shared platform IP addresses; size this limit accordingly. -->
    <rate-limit-by-key calls="60" renewal-period="60" counter-key="@(context.Request.IpAddress)" />
  </inbound>
  <backend>
    <!-- Stream server-sent events back without buffering. -->
    <forward-request buffer-response="false" />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
